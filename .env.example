# Puerto del balanceador nginx (único puerto publicado). Cambialo si el 80 está ocupado.
NGINX_PORT=80

# Base SQL dockerizada (servicio postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_esta_contraseña
POSTGRES_DB=eventos

# Qué base usan las réplicas de la API: postgres | mongo
DB_CLIENT=postgres

# Base "vía web": MongoDB Atlas (SO-6). Se pasa por privado.
MONGO_URI=

# Login con Clerk (las mismas claves del backend). Se pasan por privado.
# Si quedan vacías, el sistema entra en modo desarrollo con DEV_ID_USUARIO.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DEV_ID_USUARIO=1
