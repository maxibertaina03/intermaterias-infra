# Producción (VPS). Se crea con: bash scripts/generar-env.sh  → después completar a mano.
# Este archivo NO se sube a git (.env está en .gitignore).

# Dominios: la landing y el sistema. Sin dominio propio: IP-CON-GUIONES.sslip.io
DOMINIO=
DOMINIO_APP=
CERTBOT_EMAIL=

# Imágenes (las publica GitHub Actions). Las versiones las escribe deploy.sh.
REGISTRY=ghcr.io/maxibertaina03
SISTEMA_TAG=
LANDING_TAG=

# Base de datos (la contraseña la genera generar-env.sh)
POSTGRES_USER=eventos
POSTGRES_PASSWORD=
POSTGRES_DB=eventos

# Clerk: claves de la instancia que corresponda (pk_test/sk_test o pk_live/sk_live).
# La sk se escribe directo en el servidor: nunca en el chat ni en git.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Datos de contacto de la landing (deploy.sh arma landing/config.js con esto)
LANDING_WHATSAPP=5493510000000
LANDING_EMAIL=contacto@tudominio.com

# Backups locales (los hace deploy.sh antes de migrar)
RETENCION_DIAS=14
